{
  "name": "reviewraccoon-plugin-e2e",
  "private": true,
  "version": "0.1.0",
  "description": "Playwright E2E tests for ReviewRaccoon Chrome extension",
  "scripts": {
    "test": "playwright test",
    "test:debug": "PWDEBUG=1 playwright test --headed",
    "test:xvfb": "xvfb-run -a npm run test",
    "test:agent": "bash scripts/run-e2e.sh",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}
